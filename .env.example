# --- Model (required) --------------------------------------------------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# --- Mode ---------------------------------------------------------------------
# local (default): one user, no sign-in, SQLite, worker runs inside the app.
# oidc: hosted SaaS. Needs .streamlit/secrets.toml (see the example) and ENCRYPTION_KEY below.
AUTH_MODE=local

# --- Hosted only ---------------------------------------------------------------
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separate several keys to rotate (newest first). Losing every key means losing the data.
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
# DATABASE_URL=postgresql+psycopg://careerready:PASSWORD@db/careerready   (set by docker-compose)

# --- Billing (optional) ---------------------------------------------------------
STRIPE_WEBHOOK_SECRET=       # whsec_... from the Stripe dashboard webhook endpoint
STRIPE_PAYMENT_LINK=         # Payment Link for the Pro plan
STRIPE_PORTAL_URL=           # Customer portal link
